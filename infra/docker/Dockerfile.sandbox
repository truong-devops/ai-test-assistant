FROM golang:1.26.6-alpine

ARG BUILD_VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="AI Test Assistant Go Sandbox" \
      org.opencontainers.image.version="$BUILD_VERSION" \
      org.opencontainers.image.revision="$VCS_REF"

RUN mkdir -p /workspace /tmp/go-build /tmp/go \
    && chmod 0777 /workspace /tmp/go-build /tmp/go

WORKDIR /workspace
ENV HOME=/tmp \
    GOCACHE=/tmp/go-build \
    GOPATH=/tmp/go \
    GOTOOLCHAIN=local \
    GOPROXY=off \
    GOSUMDB=off \
    CGO_ENABLED=0

USER 65532:65532
CMD ["go", "test", "./..."]
