APP_ENV=production
LOG_LEVEL=info
HTTP_ADDR=:8080
DATABASE_MAX_CONNS=20
SHUTDOWN_TIMEOUT=20s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_RATE_LIMIT_RPS=20
HTTP_RATE_LIMIT_BURST=40
HTTP_RATE_LIMIT_MAX_CLIENTS=10000

# Bind application ports to loopback and terminate TLS in a host reverse proxy.
BIND_ADDRESS=127.0.0.1
API_PORT=8080
FRONTEND_PORT=3000
DOCKER_GID=0

POSTGRES_DB=ai_test_assistant
POSTGRES_USER=ai_test_assistant

GITLAB_BASE_URL=https://gitlab.com
GITLAB_REQUEST_TIMEOUT=15s
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT=15s
WORKER_POLL_INTERVAL=2s
WORKER_RETRY_DELAY=5s
WORKER_LEASE_DURATION=5m
WORKER_MAX_ATTEMPTS=3
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hash-v1

LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_REQUEST_TIMEOUT=60s
LLM_MAX_OUTPUT_TOKENS=6000
LLM_INPUT_COST_PER_MTOK_USD=0
LLM_OUTPUT_COST_PER_MTOK_USD=0

SANDBOX_IMAGE=ai-test-assistant-sandbox:phase11
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=128
MAX_REPAIR_ATTEMPTS=2

# Secret paths are resolved relative to infra/compose/docker-compose.prod.yml.
# Keep the files in the repository-root secrets/ directory and never commit them.
POSTGRES_PASSWORD_SECRET_FILE=../../secrets/postgres_password
DATABASE_URL_SECRET_FILE=../../secrets/database_url
GITLAB_TOKEN_SECRET_FILE=../../secrets/gitlab_token
GITLAB_WEBHOOK_SECRET_FILE=../../secrets/gitlab_webhook_secret
GITHUB_TOKEN_SECRET_FILE=../../secrets/github_token
GITHUB_WEBHOOK_SECRET_FILE=../../secrets/github_webhook_secret
LLM_API_KEY_SECRET_FILE=../../secrets/llm_api_key
