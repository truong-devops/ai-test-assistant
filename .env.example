APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_test_assistant?sslmode=disable
DATABASE_MAX_CONNS=10
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_RATE_LIMIT_RPS=20
HTTP_RATE_LIMIT_BURST=40
HTTP_RATE_LIMIT_MAX_CLIENTS=10000

# Phase 9 Human Review UI. Docker Compose exposes the Next.js console on this port.
FRONTEND_PORT=3000
DOCKER_GID=0

# GitLab and worker configuration. Keep real secrets in .env only.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_REQUEST_TIMEOUT=15s
WORKER_POLL_INTERVAL=2s
WORKER_RETRY_DELAY=5s
WORKER_LEASE_DURATION=5m
WORKER_MAX_ATTEMPTS=3
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hash-v1

# Phase 5, 6, and 8 recommendation/generation/repair provider. Set it to openai and
# supply a real key/model only in a private .env or secret manager.
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT=60s
LLM_MAX_OUTPUT_TOKENS=6000

# Phase 7 isolated Docker validation. The sandbox runs without network access.
SANDBOX_IMAGE=ai-test-assistant-sandbox:phase7
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=128

# Phase 8 bounded AI repair loop. Use 0 to disable repairs; hard maximum is 3.
MAX_REPAIR_ATTEMPTS=2
